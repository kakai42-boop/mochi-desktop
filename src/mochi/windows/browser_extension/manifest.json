{
  "manifest_version": 3,
  "name": "Mochi Browser Mood",
  "description": "Optional local bridge for Mochi\u2019s playful tab countdown.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "alarms",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "incognito": "not_allowed"
}
